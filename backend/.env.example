# ChronoPlan backend configuration (environment variables; copy to your shell/IDE run config).
# SQLite file. Relative paths are resolved from the working directory; the parent
# directory is created on startup. Default: ./data/chronoplan.db
CHRONOPLAN_DB_PATH=./data/chronoplan.db
# How long SQLite waits on a locked database before returning "unavailable" (ms, 0..600000). Default 5000.
CHRONOPLAN_DB_BUSY_TIMEOUT_MS=5000
# HTTP port. Cloud platforms set PORT; CHRONOPLAN_PORT overrides it. Default 8080.
PORT=8080
# CHRONOPLAN_PORT=8080
# Interface to bind. 127.0.0.1 = local development only; use 0.0.0.0 in containers/cloud.
CHRONOPLAN_BIND_ADDR=127.0.0.1
# Access-Control-Allow-Origin. "*" is for development ONLY; set the exact frontend origin when deployed.
CHRONOPLAN_CORS_ORIGIN=*

# ---- Authentication -------------------------------------------------------------------------
# development (default) | production. Production refuses to start unless the origin below is an
# exact https:// origin and cookies are Secure.
CHRONOPLAN_ENV=development
# Exact frontend origin. Cookie authentication cannot work with "*". Defaults to http://localhost:5173
# in development; required in production. (Also drives CORS, which now allows credentials.)
CHRONOPLAN_CORS_ORIGIN=http://localhost:5173
# Google OAuth client id (public). Empty disables Google sign-in. No client secret is needed:
# the backend verifies the ID token's signature against Google's public keys.
GOOGLE_CLIENT_ID=
# Cookie attributes. Secure defaults to true in production. If the frontend and API are on different
# registrable domains use SameSite=None (requires Secure=true); same-site deployments should keep Lax.
# CHRONOPLAN_COOKIE_SECURE=true
# CHRONOPLAN_COOKIE_SAMESITE=Lax
# Session lifetime (absolute) and idle timeout, in seconds. Defaults: 14 days / 7 days.
# CHRONOPLAN_SESSION_TTL_SECONDS=1209600
# CHRONOPLAN_SESSION_IDLE_SECONDS=604800
# Set to true ONLY behind exactly one trusted reverse proxy that appends X-Forwarded-For;
# otherwise login throttling would see every client as the proxy's address.
# CHRONOPLAN_TRUST_X_FORWARDED_FOR=false
