# Base URL of the ChronoPlan C++ backend (no trailing slash).
# Must match the backend's CHRONOPLAN_BIND_ADDR / PORT, and the backend's
# CHRONOPLAN_CORS_ORIGIN must allow this frontend's origin.
VITE_API_BASE_URL=http://localhost:8080
# Optional request timeout in milliseconds (default 10000).
# VITE_API_TIMEOUT_MS=10000

# Google OAuth *client id* for "Sign in with Google" (public value; never put a client secret here).
# Must equal the backend's GOOGLE_CLIENT_ID. Leave empty to show the button as "not configured".
VITE_GOOGLE_CLIENT_ID=
